{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "Node",
    "types": ["node"],
    "strict": true,
//    "noImplicitAny": true,
    "strictFunctionTypes": true
  },
  // The dev harness in app/ is not part of the published library, and must not
  // reach the dts build. It has its own tsconfig.
  "include": ["src"],
  "exclude": ["app", "dist", "node_modules"]
}
