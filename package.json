{
  "name": "vue3-component-store",
  "version": "0.2.1",
  "description": "component store solution for vue 3",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run build",
    "publish": "npm run build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amir-armantaheri/component-store.git"
  },
  "keywords": [
    "component-store",
    "vue",
    "vue3",
    "vue3-component-store",
    "vue3-store",
    "store",
    "pinia",
    "vuex",
    "local store",
    "vue 3 store",
    "vue 3 component store"
  ],
  "author": "amirhosein.taheri",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/amir-armantaheri/component-store/issues"
  },
  "homepage": "https://github.com/amir-armantaheri/component-store#readme",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vue/compiler-sfc": "^3.5.41",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/language-core": "^3.3.9",
    "typescript": "^6.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.41"
  }
}
